# ==========================================
# CODELIVE — .gitignore
# ==========================================

# --- Dependencias Node ---
node_modules/
sources/frontend/node_modules/
sources/backend/node_modules/

# --- Archivos de Entorno (NUNCA subas secretos!) ---
.env
.env.local
.env.*.local
.env.production
.env.docker
sources/frontend/.env.local
sources/backend/.env

# --- Builds y Compilación ---
dist/
build/
out/
.vite/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- IDEs y Editores ---
.vscode/
.idea/

# --- Sistema Operativo ---
.DS_Store
Thumbs.db

# --- Archivos temporales ---
*.swp
*.swo
.tmp/
temp/
