# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Database Settings (Option 1: PostgreSQL Connection URL - Recommended for Production/Render)
# DATABASE_URL=postgres://admin:admin@localhost:5432/codelive_db

# Database Settings (Option 2: Individual Parameters - Used if DATABASE_URL is not set)
DB_USER=admin
DB_PASSWORD=admin
DB_HOST=localhost
DB_NAME=codelive_db
DB_PORT=5432

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=https://codelive-pvo7.vercel.app

# Frontend URL (used to build the password reset link in emails)
FRONTEND_URL=https://codelive-pvo7.vercel.app

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Configure these to enable the "Forgot password" email functionality.
# For Gmail: create an App Password (Google Account → Security → App passwords).
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
